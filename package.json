{
  "name": "tarot-up-my-heart",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "pretest": "svelte-kit sync",
    "test": "svelte-kit sync && vitest run --passWithNoTests",
    "test:contracts": "svelte-kit sync && vitest run tests/contracts --passWithNoTests",
    "test:mocks": "svelte-kit sync && vitest run tests/mocks --passWithNoTests",
    "test:integration": "svelte-kit sync && vitest run tests/integration --passWithNoTests",
    "test:real": "svelte-kit sync && vitest run tests/real --passWithNoTests",
    "test:all": "npm run test:contracts && npm run test:mocks && npm run test:integration && npm run test:real",
    "lint": "prettier --check . && eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "validate:contracts": "echo '✅ Contract validation - to be implemented'",
    "validate:mocks": "echo '✅ Mock coverage validation - to be implemented'",
    "validate:seams": "echo '✅ Seams documentation validation - to be implemented'",
    "validate:all": "npm run validate:contracts && npm run validate:mocks && npm run validate:seams",
    "ci": "npm run lint && npm run check && npm run test:all && npm run build",
    "prepare": "husky"
  },
  "devDependencies": {
    "@sveltejs/adapter-vercel": "^7.0.3",
    "@sveltejs/kit": "^3.2.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@types/node": "^24.10.0",
    "@typescript-eslint/eslint-plugin": "^8.46.0",
    "@typescript-eslint/parser": "^8.46.0",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-svelte": "^2.35.1",
    "husky": "^9.1.7",
    "jsdom": "^27.1.0",
    "prettier": "3.6.2",
    "prettier-plugin-svelte": "3.4.0",
    "svelte": "^5.57.1",
    "svelte-check": "^4.7.8",
    "typescript": "^6.0.3",
    "vite": "^8.0.12",
    "vitest": "^5.1.0"
  },
  "engines": {
    "node": ">=22.17.0"
  },
  "dependencies": {
    "@vercel/blob": "^2.9.0",
    "jszip": "^3.10.1",
    "openai": "^7.55.0"
  },
  "overrides": {
    "zod": "4.6.7",
    "@vercel/blob": {
      "@vercel/oidc": "4.0.8"
    },
    "@vercel/nft": {
      "glob": "14.0.6"
    },
    "@typescript-eslint/typescript-estree": {
      "minimatch": "11.0.8"
    }
  }
}
